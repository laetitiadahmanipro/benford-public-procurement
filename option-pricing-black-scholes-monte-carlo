    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.stats import norm\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ----- Black-Scholes -----\n",
        "def d1_d2(S, K, T, r, sigma):\n",
        "    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))\n",
        "    return d1, d1 - sigma * np.sqrt(T)\n",
        "\n",
        "def bs_price(S, K, T, r, sigma, option=\"call\"):\n",
        "    d1, d2 = d1_d2(S, K, T, r, sigma)\n",
        "    if option == \"call\":\n",
        "        return S * norm.cdf(d1) - K * np.exp(-r * T) * norm.cdf(d2)\n",
        "    return K * np.exp(-r * T) * norm.cdf(-d2) - S * norm.cdf(-d1)\n",
        "\n",
        "def bs_delta(S, K, T, r, sigma):\n",
        "    d1, _ = d1_d2(S, K, T, r, sigma)\n",
        "    return norm.cdf(d1)\n",
        "\n",
        "def bs_vega(S, K, T, r, sigma):\n",
        "    d1, _ = d1_d2(S, K, T, r, sigma)\n",
        "    return S * norm.pdf(d1) * np.sqrt(T)\n",
        "\n",
        "# ----- Monte Carlo (simulation) -----\n",
        "def mc_price(S, K, T, r, sigma, n=100000, seed=42, z=None):\n",
        "    if z is None:\n",
        "        z = np.random.default_rng(seed).standard_normal(n)\n",
        "    ST = S * np.exp((r - 0.5 * sigma**2) * T + sigma * np.sqrt(T) * z)\n",
        "    gain = np.exp(-r * T) * np.maximum(ST - K, 0)\n",
        "    return gain.mean(), gain.std(ddof=1) / np.sqrt(len(gain))\n",
        "\n",
        "def mc_delta(S, K, T, r, sigma, n=100000, seed=42):\n",
        "    z = np.random.default_rng(seed).standard_normal(n)\n",
        "    h = 0.01 * S\n",
        "    haut, _ = mc_price(S + h, K, T, r, sigma, z=z)\n",
        "    bas, _ = mc_price(S - h, K, T, r, sigma, z=z)\n",
        "    return (haut - bas) / (2 * h)\n",
        "\n",
        "def mc_vega(S, K, T, r, sigma, n=100000, seed=42):\n",
        "    z = np.random.default_rng(seed).standard_normal(n)\n",
        "    h = 0.01\n",
        "    haut, _ = mc_price(S, K, T, r, sigma + h, z=z)\n",
        "    bas, _ = mc_price(S, K, T, r, sigma - h, z=z)\n",
        "    return (haut - bas) / (2 * h)"
